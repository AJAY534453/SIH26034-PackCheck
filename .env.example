# PACKCHECK AI — environment configuration (copy to .env and adjust as needed)
# Every value is optional; the application runs a complete on-device pipeline with none of them.

# ---------- Backend ----------
POCKET_HOST=127.0.0.1
POCKET_PORT=8001
POCKET_FRONTEND_ORIGIN=http://localhost:5174

# ---------- Database (SQLite by default) ----------
POCKET_DATABASE_URL=sqlite:///./storage/pocket.db

# ---------- Security ----------
# Set a strong secret in production. Never commit the real .env.
POCKET_SECRET_KEY=change-me-in-production
POCKET_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- Storage & uploads ----------
POCKET_STORAGE_DIR=./storage
POCKET_MAX_UPLOAD_MB=15

# ---------- OCR (primary reader: on-device, offline, no key required) ----------
# POCKET_OCR_ENGINE=rapidocr

# ---------- Vision extraction (OPTIONAL second perception source) ----------
# Leave GEMINI_API_KEY empty to run OCR-only: every page still works, and the UI states
# plainly that no vision provider is configured. When a key IS present, the provider reads
# the package images and its readings enter the pipeline as CANDIDATES — validated, ranked
# against the OCR evidence, and marked for human review whenever the two disagree. The
# provider never decides compliance.
#
# The key is read server-side only. It is never sent to the browser, logged, or returned by
# any endpoint, and it must never be placed in frontend code or VITE_* variables.
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
# auto = use the provider when a key is present; 0 = never call an external provider.
AI_ENABLED=auto
AI_TIMEOUT_SECONDS=60

# ---------- Bill Scanner ----------
# A price gap smaller than this percentage of MRP is not worth an inspector's attention.
BILL_PRICE_TOLERANCE_PCT=0.5
